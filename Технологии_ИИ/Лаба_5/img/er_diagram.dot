fact_failure_event [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9d9d9" colspan="3"><b>fact_failure_event</b></td></tr><tr><td align="left" port="failure_event_key_w"><b>failure_event_key</b></td><td align="left"><font color="#555555">integer</font></td><td align="left" port="failure_event_key_e">PK</td></tr><tr><td align="left" port="udi_w"><i>udi</i></td><td align="left"><font color="#555555">integer</font></td><td align="left" port="udi_e">FK</td></tr><tr><td align="left" port="equipment_key_w"><i>equipment_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="equipment_key_e">FK</td></tr><tr><td align="left" port="class_key_w"><i>class_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="class_key_e">FK</td></tr><tr><td align="left" port="tool_key_w"><i>tool_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="tool_key_e">FK</td></tr><tr><td align="left" port="failure_type_key_w"><i>failure_type_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="failure_type_key_e">FK</td></tr><tr><td align="left" port="batch_key_w"><i>batch_key</i></td><td align="left"><font color="#555555">integer</font></td><td align="left" port="batch_key_e">FK</td></tr><tr><td align="left" port="is_primary_w">is_primary</td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="is_primary_e"></td></tr><tr><td align="left" port="event_count_w">event_count</td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="event_count_e"></td></tr></table>>];
{rank=same; dim_equipment; dim_quality_class; dim_tool; dim_failure_type; dim_batch}
{rank=min; fact_observation}
{rank=max; fact_failure_event}
fact_observation:equipment_key_e:e -> dim_equipment:equipment_key_w:w [dir=both, arrowtail=crow, arrowhead=tee];
fact_observation:class_key_e:e -> dim_quality_class:class_key_w:w [dir=both, arrowtail=crow, arrowhead=tee];
fact_observation:tool_key_e:e -> dim_tool:tool_key_w:w [dir=both, arrowtail=crow, arrowhead=tee];
