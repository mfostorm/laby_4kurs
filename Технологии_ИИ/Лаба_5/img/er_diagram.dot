fact_observation [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9d9d9" colspan="3"><b>fact_observation</b></td></tr><tr><td align="left" port="observation_key_w"><b>observation_key</b></td><td align="left"><font color="#555555">integer</font></td><td align="left" port="observation_key_e">PK</td></tr><tr><td align="left" port="udi_w">udi</td><td align="left"><font color="#555555">integer</font></td><td align="left" port="udi_e">UK</td></tr><tr><td align="left" port="product_id_w">product_id</td><td align="left"><font color="#555555">varchar(10)</font></td><td align="left" port="product_id_e">UK</td></tr><tr><td align="left" port="product_serial_w">product_serial</td><td align="left"><font color="#555555">integer</font></td><td align="left" port="product_serial_e"></td></tr><tr><td align="left" port="equipment_key_w"><i>equipment_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="equipment_key_e">FK</td></tr><tr><td align="left" port="class_key_w"><i>class_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="class_key_e">FK</td></tr><tr><td align="left" port="tool_key_w"><i>tool_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="tool_key_e">FK</td></tr><tr><td align="left" port="failure_type_key_w"><i>failure_type_key</i></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="failure_type_key_e">FK</td></tr><tr><td align="left" port="batch_key_w"><i>batch_key</i></td><td align="left"><font color="#555555">integer</font></td><td align="left" port="batch_key_e">FK</td></tr><tr><td align="left" port="air_temp_k_w">air_temp_k</td><td align="left"><font color="#555555">numeric(5,1)</font></td><td align="left" port="air_temp_k_e"></td></tr><tr><td align="left" port="process_temp_k_w">process_temp_k</td><td align="left"><font color="#555555">numeric(5,1)</font></td><td align=