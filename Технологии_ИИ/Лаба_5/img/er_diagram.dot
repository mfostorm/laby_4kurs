dim_failure_type [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#efefef" colspan="3"><b>dim_failure_type</b></td></tr><tr><td align="left" port="failure_type_key_w"><b>failure_type_key</b></td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="failure_type_key_e">PK</td></tr><tr><td align="left" port="failure_code_w">failure_code</td><td align="left"><font color="#555555">varchar(8)</font></td><td align="left" port="failure_code_e">UK</td></tr><tr><td align="left" port="failure_name_w">failure_name</td><td align="left"><font color="#555555">varchar(60)</font></td><td align="left" port="failure_name_e"></td></tr><tr><td align="left" port="rule_condition_w">rule_condition</td><td align="left"><font color="#555555">varchar(120)</font></td><td align="left" port="rule_condition_e"></td></tr><tr><td align="left" port="recommended_action_w">recommended_action</td><td align="left"><font color="#555555">varchar(120)</font></td><td align="left" port="recommended_action_e"></td></tr><tr><td align="left" port="severity_rank_w">severity_rank</td><td align="left"><font color="#555555">smallint</font></td><td align="left" port="severity_rank_e"></td></tr><tr><td align="left" port="is_target_w">is_target</td><td align="left"><font color="#555555">boolean</font></td><td align="left" port="is_target_e"></td></tr></table>>];
