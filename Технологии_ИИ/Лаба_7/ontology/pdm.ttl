# Прогнозы - результат срабатывания правил на наблюдениях
pdm:RF_51 a pdm:RiskForecast , owl:NamedIndividual ; pdm:generatedBy pdm:R_PWF ; pdm:concernsObservation pdm:Obs_51 ;
    pdm:predictsFailureType pdm:PWF ; pdm:riskScore "1.0"^^xsd:decimal ; pdm:riskLevel "high" .
pdm:RF_78 a pdm:RiskForecast , owl:NamedIndividual ; pdm:generatedBy pdm:R_TWF ; pdm:concernsObservation pdm:Obs_78 ;
    pdm:predictsFailureType pdm:TWF ; pdm:riskScore "0.06"^^xsd:decimal ; pdm:riskLevel "low" .
pdm:RF_161 a pdm:RiskForecast , owl:NamedIndividual ; pdm:generatedBy pdm:R_OSF ; pdm:concernsObservation pdm:Obs_161 ;
    pdm:predictsFailureType pdm:OSF ; pdm:riskScore "1.0"^^xsd:decimal ; pdm:riskLevel "high" .
pdm:RF_3237 a pdm:RiskForecast , owl:NamedIndividual ; pdm:generatedBy pdm:R_HDF ; pdm:concernsObservation pdm:Obs_3237 ;
    pdm:predictsFailureType pdm:HDF ; pdm:riskScore "1.0"^^xsd:decimal ; pdm:riskLevel "high" .
