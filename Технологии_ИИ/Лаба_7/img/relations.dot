digraph rel { rankdir=LR; nodesep=0.3; ranksep=0.9; splines=true;
node [shape=plaintext, fontname="DejaVu Sans", fontsize=9];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555", arrowsize=0.7];
Equipment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#dbe9f6"><tr><td><b>Equipment</b></td></tr><tr><td><i>Оборудование</i></td></tr><tr><td align="left">inventoryNumber : string</td></tr><tr><td align="left">nominalPowerW : dec</td></tr><tr><td align="left">powerMaxW : dec</td></tr><tr><td align="left">powerMinW : dec</td></tr></table>>];
Component [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#dbe9f6"><tr><td><b>Component</b></td></tr><tr><td><i>Узел (компонент)</i></td></tr></table>>];
Sensor [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#dbe9f6"><tr><td><b>Sensor</b></td></tr><tr><td><i>Датчик</i></td></tr></table>>];
MonitoredParameter [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#dbe9f6"><tr><td><b>MonitoredParameter</b></td></tr><tr><td><i>Контролируемый параметр</i></td></tr><tr><td align="left">unit : string</td></tr></table>>];
Product [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e2f0d9"><tr><td><b>Product</b></td></tr><tr><td><i>Изделие</i></td></tr><tr><td align="left">productId : string</td></tr></table>>];
QualityClass [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e2f0d9"><tr><td><b>QualityClass</b></td></tr><tr><td><i>Класс качества</i></td></tr><tr><td align="left">classCode : string</td></tr><tr><td align="left">osfLimit : int</td></tr><tr><td align="left">wearStepMin : int</td></tr></table>>];
ToolLifeCycle [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e2f0d9"><tr><td><b>ToolLifeCycle</b></td></tr><tr><td><i>Цикл эксплуатации инструмента</i></td></tr><tr><td align="left">cycleNumber : int+</td></tr><tr><td align="left">endReason : enum</td></tr><tr><td align="left">productsProcessed : int+</td></tr><tr><td align="left">wearAtEndMin : int</td></tr></table>>];
Observation [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e2f0d9"><tr><td><b>Observation</b></td></tr><tr><td><i>Наблюдение</i></td></tr><tr><td align="left">airTemperatureK : dec</td></tr><tr><td align="left">positionInCycle : int+</td></tr><tr><td align="left">powerW : dec</td></tr><tr><td align="left">processTemperatureK : dec</td></tr><tr><td align="left">rotationalSpeedRpm : int</td></tr><tr><td align="left">temperatureDifferenceK : dec</td></tr><tr><td align="left">toolWearMin : int</td></tr><tr><td align="left">torqueNm : dec</td></tr><tr><td align="left">udi : int</td></tr><tr><td align="left">wearTorque : dec</td></tr></table>>];
FailureEvent [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f8dcdc"><tr><td><b>FailureEvent</b></td></tr><tr><td><i>Событие отказа</i></td></tr></table>>];
FailureType [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#f8dcdc"><tr><td><b>FailureType</b></td></tr><tr><td><i>Тип отказа</i></td></tr><tr><td align="left">failureCode : string</td></tr><tr><td align="left">severityRank : int</td></tr></table>>];
ProductionRule [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e8def3"><tr><td><b>ProductionRule</b></td></tr><tr><td><i>Продукционное правило</i></td></tr><tr><td align="left">certaintyFactor : dec[0..1]</td></tr><tr><td align="left">conditionText : string</td></tr><tr><td align="left">ruleCode : string</td></tr></table>>];
RiskForecast [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#e8def3"><tr><td><b>RiskForecast</b></td></tr><tr><td><i>Прогноз риска</i></td></tr><tr><td align="left">riskLevel : enum</td></tr><tr><td align="left">riskScore : dec[0..1]</td></tr></table>>];
MaintenanceAction [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>MaintenanceAction</b></td></tr><tr><td><i>Вид работ по обслуживанию</i></td></tr><tr><td align="left">actionName : string</td></tr></table>>];
MaintenanceRequest [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>MaintenanceRequest</b></td></tr><tr><td><i>Заявка на ремонт</i></td></tr></table>>];
WorkOrder [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>WorkOrder</b></td></tr><tr><td><i>Наряд на работы</i></td></tr><tr><td align="left">plannedStart : dateTime</td></tr><tr><td align="left">workCost : dec</td></tr></table>>];
MaintenanceRegulation [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>MaintenanceRegulation</b></td></tr><tr><td><i>Регламент ТО</i></td></tr></table>>];
RepairTeam [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>RepairTeam</b></td></tr><tr><td><i>Ремонтная бригада</i></td></tr><tr><td align="left">teamSize : int+</td></tr></table>>];
SparePart [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2" bgcolor="#fbe5cc"><tr><td><b>SparePart</b></td></tr><tr><td><i>Запасная часть</i></td></tr><tr><td align="left">stockQuantity : int</td></tr></table>>];
FailureType -> Component [label="affectsComponent"];
WorkOrder -> RepairTeam [label="assignedTo"];
MaintenanceRequest -> RiskForecast [label="basedOnForecast"];
RiskForecast -> Observation [label="concernsObservation"];
ToolLifeCycle -> Equipment [label="cycleOnEquipment"];
MonitoredParameter -> MonitoredParameter [label="derivedFrom"];
ProductionRule -> FailureType [label="detects"];
WorkOrder -> MaintenanceRegulation [label="followsRegulation"];
WorkOrder -> MaintenanceRequest [label="fulfillsRequest"];
RiskForecast -> ProductionRule [label="generatedBy"];
Equipment -> Component [label="hasComponent", style=bold, color="#2f5d8a"];
Observation -> FailureEvent [label="hasFailureEvent"];
FailureEvent -> FailureType [label="hasFailureType"];
Product -> QualityClass [label="hasQualityClass"];
Sensor -> Component [label="installedOn ⊑ partOf", style=bold, color="#2f5d8a"];
MonitoredParameter -> Sensor [label="measuredBy"];
Observation -> Observation [label="nextObservation"];
Observation -> Equipment [label="observedOn"];
WorkOrder -> MaintenanceAction [label="performsAction"];
RiskForecast -> FailureType [label="predictsFailureType"];
Observation -> Product [label="processesProduct"];
FailureType -> MaintenanceAction [label="recommendsAction"];
MaintenanceRegulation -> Equipment [label="regulationFor"];
ProductionRule -> MonitoredParameter [label="usesParameter"];
WorkOrder -> SparePart [label="usesSparePart"];
Observation -> ToolLifeCycle [label="usesToolCycle"];
}